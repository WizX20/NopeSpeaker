<Project Sdk="Microsoft.NET.Sdk">
  <!-- xUnit v3 on Microsoft.Testing.Platform (global.json: `dotnet test` from the repository root,
       or `dotnet run` this project), with FluentAssertions. FluentAssertions stays on 7.x: from 8.0
       on it carries a commercial license (Xceed); 7.x is Apache 2.0. .github/dependabot.yml
       ignores its major updates. The tests cover the pure parts of the core - nothing here reads
       or changes a real device. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="7.2.2" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="FluentAssertions" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\xBlueTooth.Core\xBlueTooth.Core.csproj" />
  </ItemGroup>
</Project>
