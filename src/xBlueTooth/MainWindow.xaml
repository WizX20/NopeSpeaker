<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="XBlueTooth.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XBlueTooth"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Title="xBlueTooth">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: the app draws it, Mica shows through. -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE702;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="xBlueTooth" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="40,8,40,40">
            <StackPanel MaxWidth="1000" Spacing="4">
                <TextBlock Text="Bluetooth devices" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"
                           Text="Choose which paired devices Windows may play audio on. Switch one off and it still pairs and connects, but Windows no longer moves your sound to it the moment it comes in range. Changing a device asks for administrator rights." />

                <InfoBar x:Name="Status" IsOpen="False" Margin="0,0,0,8" />

                <Grid Margin="0,8,0,4">
                    <TextBlock Text="Paired devices" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <ProgressRing x:Name="Loading" IsActive="False" Width="16" Height="16" />
                        <HyperlinkButton Content="Bluetooth settings" Click="OnBluetoothSettingsClick" />
                        <Button Click="OnRefreshClick" ToolTipService.ToolTip="Refresh">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Asking Windows which paired devices are connected takes a few seconds. -->
                <TextBlock x:Name="FirstLoad" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Looking for paired devices…" />

                <TextBlock x:Name="Empty" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="No paired Bluetooth devices." />

                <ItemsRepeater x:Name="Devices">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:DeviceItem">
                            <toolkit:SettingsCard Header="{x:Bind Name, Mode=OneWay}" Description="{x:Bind Description, Mode=OneWay}">
                                <toolkit:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" />
                                </toolkit:SettingsCard.HeaderIcon>
                                <Grid>
                                    <ToggleSwitch Tag="{x:Bind}" IsOn="{x:Bind IsAudioEnabled, Mode=OneWay}" IsEnabled="{x:Bind IsIdle, Mode=OneWay}"
                                                  Visibility="{x:Bind HasAudio, Mode=OneWay}" OnContent="Audio on" OffContent="Audio off"
                                                  Toggled="OnAudioToggled" />
                                </Grid>
                            </toolkit:SettingsCard>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
